# Copy to .env for local dev, or set as a repo secret/CI variable for the
# GitHub Pages build. Points at the deployed cloudflare-turn-worker; see
# cloudflare-turn-worker/README.md. If unset, the app falls back to the
# free Open Relay Project TURN servers.
VITE_TURN_WORKER_URL=https://simple-vtt-turn.<your-subdomain>.workers.dev
